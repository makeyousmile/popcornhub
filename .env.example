# PopcornHub Server Configuration Example

# Application Port
PORT=8085

# MongoDB Connection
MONGO_URI=mongodb://mongo:27017
MONGO_DB=popcornhub

# Redis Connection
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_key_in_production

# Token Bucket Rate Limiter (ms between actions per user)
RATE_LIMIT_INTERVAL_MS=1500

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
